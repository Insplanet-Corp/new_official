{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-buildcheck/types/**/*.ts",
    ".next-buildcheck/dev/types/**/*.ts",
    ".next-prod/types/**/*.ts",
    ".next-prod/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    // Supabase Edge Function 은 Deno 런타임이다 — `Deno` 전역과 https:// import 를
    // 쓰므로 이 Node 용 tsconfig 로 검사하면 무조건 실패한다. 검사는 Deno 쪽에서
    // 한다(`supabase functions deploy` 가 배포 시 확인).
    "supabase/functions"
  ]
}
