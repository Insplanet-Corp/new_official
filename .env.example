# ---------------------------------------------------------------------------
# 이 파일을 복사해서 .env.local 을 만든 뒤, 실제 값을 채워 넣으세요.
#
#   cp .env.example .env.local
#
# 실제 값은 보안상 저장소에 포함되어 있지 않습니다.
# 값이 필요하면 프로젝트 담당자에게 문의해 주세요.
# ---------------------------------------------------------------------------

# Supabase 프로젝트 URL (Supabase 대시보드 > Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase anon(public) 키 (Supabase 대시보드 > Project Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Supabase service_role 키 (대시보드 > Project Settings > API > service_role)
#
# ⚠️ 이 키는 RLS 를 전부 우회합니다. 절대 브라우저로 나가면 안 됩니다.
#    - NEXT_PUBLIC_ 접두사를 붙이지 마세요 (붙이면 번들에 실려 DB 전체가 열립니다)
#    - 서버 코드에서만 읽습니다 (src/lib/supabaseAdmin.ts)
#
# 용도: 사용자관리 신규 계정 등록(/api/admin/users). 없으면 등록만 503 이 되고
#       나머지 화면은 정상 동작합니다.
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
